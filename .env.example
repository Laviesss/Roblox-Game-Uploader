# ==========================================
# ROBLOX PUBLISHING PLATFORM - CONFIGURATION
# ==========================================

# --- DATABASE (Neon / PostgreSQL) ---
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# --- AUTHENTICATION & SECURITY ---
# 32-character random string for AES-256-GCM
ENCRYPTION_KEY="your-32-char-encryption-key-here"
# Secret for JWT signing
JWT_SECRET="your-jwt-secret-here"
# Secret for NextAuth.js
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Base URL for NextAuth (e.g., https://your-site.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# --- BACKEND API ---
PORT=3001
# Production frontend URL for CORS (e.g., https://your-site.vercel.app)
CORS_ORIGIN="http://localhost:3000"

# --- CLOUDFLARE R2 (S3 COMPATIBLE STORAGE) ---
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
# Example: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT="your-r2-endpoint"

# --- DISCORD BOT ---
DISCORD_TOKEN="your-discord-bot-token"
DISCORD_CLIENT_ID="your-discord-client-id"

# --- FRONTEND (WEB) ---
# Used for client-side API calls
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001"
# Used for server-side API calls (can be the same as above or internal network URL)
BACKEND_URL="http://localhost:3001"

# --- OPTIONAL ROBLOX OPEN CLOUD ---
ROBLOX_CLIENT_ID=""
ROBLOX_CLIENT_SECRET=""
