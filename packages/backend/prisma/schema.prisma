generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Environment {
  PROD
  STAGING
  DEV
}

enum AccountStatus {
  ACTIVE
  BANNED
  EXPIRED
  LOCKED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  robloxCookie   String?         // Encrypted
  cliToken       String?         @unique
  discordId      String?         @unique
  discordCode    String?         // For linking
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  jobs           Job[]
  logs           Log[]
  universes      Universe[]
  robloxAccounts RobloxAccount[]
}

model Universe {
  id          String      @id @default(uuid())
  robloxId    BigInt      @unique
  name        String
  environment Environment @default(DEV)
  metadata    Json?
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  places      Place[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([robloxId])
}

model Place {
  id            String   @id @default(uuid())
  robloxId      BigInt   @unique
  universeId    String
  universe      Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  isRoot        Boolean
  lastSynced    DateTime @default(now())
  activeVersion Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RobloxAccount {
  id        String        @id @default(uuid())
  username  String
  cookie    String        // Encrypted
  status    AccountStatus @default(ACTIVE)
  lastUsed  DateTime?
  useCount  Int           @default(0)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Job {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'UPLOAD', 'PUBLISH', 'CREATE_UNIVERSE'
  status    String   // 'PENDING', 'RUNNING', 'COMPLETED', 'FAILED'
  details   Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Log {
  id        String   @id @default(cuid())
  userId    String
  message   String
  level     String   // 'INFO', 'WARN', 'ERROR'
  meta      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
